{
  "name": "dallateas",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^18.0.9",
      "zod": "^4.6.7",
      "lucide-react": "^1.70.0",
      "next": "^16.4.5",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "@prisma/client": "^7.10.1",
      "@trpc/server": "^11.25.0",
      "@trpc/client": "^11.25.0",
      "better-auth": "1.7.18",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5"
    }
  },
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @dallateas/db db:push",
    "db:studio": "turbo -F @dallateas/db db:studio",
    "db:generate": "turbo -F @dallateas/db db:generate",
    "db:migrate": "turbo -F @dallateas/db db:migrate",
    "lint": "turbo lint",
    "test": "bun test packages apps"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@dallateas/config": "workspace:*",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
